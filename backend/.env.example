# App
APP_NAME=StackSense
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stacksense

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — CHANGE IN PRODUCTION (min 32 chars)
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SECRET_KEY=your-super-secret-key-change-me-must-be-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_MAX_AGE=600

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=stacksense-backend
OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# Groq LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.1

# Cohere Embeddings
COHERE_API_KEY=your-cohere-api-key
COHERE_MODEL=embed-english-v3.0
COHERE_EMBEDDING_DIM=1024

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=stacksense_docs

# RAG Pipeline
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_CACHE_TTL=600
